-- Ensure the game is fully loaded before executing
if not game:IsLoaded() then game.Loaded:Wait() end

-- CUSTOM SETTINGS
local AutoStore = true
local AutoHopIfNoFruit = true
local MinimumSeaLevel = 1 -- Set to 1, 2, or 3 depending on your progress

-- ANTI-AFK ENGINE (Bypasses the 20-Minute Idle Disconnect)
local vu = game:GetService("VirtualUser")
game:GetService("Players").LocalPlayer.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- AUTOMATED SERVER HOPPER SYSTEM
local function initiateServerHop()
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local LocalPlayer = game.Players.LocalPlayer
    
    local success, serverList = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://roblox.com" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    
    if success and serverList and serverList.data then
        for _, server in pairs(serverList.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                return
            end
        end
    end
end

-- MAIN CORE LOOP: SCANS, TELEPORTS, AND STORES
task.spawn(function()
    while task.wait(2) do
        local character = game.Players.LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            local targetFruit = nil
            
            -- Scan the entire workspace map for items containing the word "Fruit"
            for _, object in pairs(workspace:GetChildren()) do
                if string.find(string.lower(object.name), "fruit") then
                    targetFruit = object
                    break
                end
            end
            
            -- If a fruit is found, teleport onto it
            if targetFruit then
                rootPart.CFrame = targetFruit:GetModelCFrame()
                task.wait(1)
                
                -- Auto-store logic if option is enabled
                if AutoStore then
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StoreFruit", targetFruit.name, targetFruit)
                end
            else
                -- If no fruits are physically on this server, initiate a server change
                if AutoHopIfNoFruit then
                    initiateServerHop()
                end
            end
        end
    end
end)
